# Every environment variable Nopa uses. Real values stay local (.env, never committed) or in
# the host's secret store. Copy the relevant block to the file named next to it.

# --- Athlete app: athlete/.env (public values, they are baked into the app) ---
# Local stack (npm run db:start) by default; athlete/.env.hosted has the hosted project's.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where supporter/ is hosted. Share links are <this>/?c=<token>.
EXPO_PUBLIC_SUPPORTER_URL=http://localhost:8080

# --- Supporter page: supporter/config.js (public values, no build step) ---
# Set in the file itself, not the environment: SUPABASE_URL and SUPABASE_ANON_KEY.

# --- Supabase CLI (local only, for `npx supabase link` / `db push`) ---
SUPABASE_PROJECT_REF=ltukqsljtzqfgpvlkdtd
SUPABASE_ACCESS_TOKEN=

# --- Edge functions only (Supabase secret store, never in client code or this repo) ---
# SUPABASE_SERVICE_ROLE_KEY is provided to edge functions by Supabase automatically.
# Sender notifications (provider not chosen yet, see the open decision in specs/product.md):
# NOTIFY_PROVIDER_API_KEY=
