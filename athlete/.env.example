# Copy to .env and fill in. All three are public values (they end up inside the app).
# Local stack (npm run db:start): URL is http://<your computer's LAN IP>:54321 when testing on
# a phone, and the anon key is printed by `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Where supporter/ is hosted. Share links are <this>/?c=<token>.
EXPO_PUBLIC_SUPPORTER_URL=http://localhost:8080
